# media-organizer — generated and local-only files
#
# The tool writes all of its state outside the source tree by default (resolved
# per platform by config.py: state dir, config dir, runtime dir). These rules are
# for the case where someone points an override *into* the checkout, e.g. running
# with MEDIA_STATE_DB=./state.db or MEDIA_ROOT=./media while testing.

# Python bytecode / caches (also covered at the repo root)
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# SQLite state: caches, placements, fetch log
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Credentials — never commit these; config.py reads them from the environment
# or from $XDG_CONFIG_HOME/media-organizer/tmdb.env
tmdb.env
*.env
.env

# Clone lock (advisory file lock serialising reflinks)
*.lock

# Generated plans and reports
plan.json
*.plan.json
*.alternatives.txt

# Test corpora and scratch trees
/media/
/MediaLibrary/
/tmp/
/scratch/

# Source manifest used by classify_folders.py (host-specific, regenerated)
manifest.tsv

# VLM audit outputs (host paths + a full folder listing; regenerated by
# vlm_audit_sweep.py, so not committed)
vlm_audit*.tsv
vlm_audit*.yaml

# Handover notes are local-only, never committed
HANDOVER.md

# Session logs / transcript-style notes are local-only, never committed
SESSION-LOG.md
session*.md

FINDINGS.md
